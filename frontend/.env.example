# ---------------------------------------------------------------------------
# Covenant Sentinel frontend configuration
#
# Copy to .env.local and fill in the two addresses printed by `npm run deploy`.
# Until BOTH addresses are set, the dashboard shows an explicit
# "deployment not configured" state instead of inventing contract state.
# ---------------------------------------------------------------------------

# GenLayer JSON-RPC endpoint used by the official genlayer-js SDK.
#   Studio / StudioNet : https://studio.genlayer.com/api
#   Local GLSim        : http://127.0.0.1:4000/api
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Deployed CovenantSentinel intelligent contract (the policy + consensus layer).
NEXT_PUBLIC_COVENANT_SENTINEL_ADDRESS=

# Deployed SentinelVault intelligent contract (the guarded child treasury).
NEXT_PUBLIC_COVENANT_VAULT_ADDRESS=

# Network identity used by the MetaMask "add / switch chain" helper.
# 61999 is GenLayer Studio; change it if you point the RPC URL elsewhere.
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN
