{
  "name": "covenant-sentinel",
  "type": "module",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "deploy": "genlayer deploy",
    "run:case": "node --env-file-if-exists=.env scripts/run-case.mjs",
    "verify:proof-v1": "node scripts/verify-proof-v1.mjs"
  },
  "devDependencies": {
    "genlayer-js": "^1.1.8"
  },
  "description": "Covenant Sentinel: a GenLayer-native policy enforcement and guarded treasury system."
}
